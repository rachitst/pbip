# Server-side environment for infra/deploy/docker-compose.prod.yml. Copy to ~/pbip/.env on the host and fill in
# every <placeholder>. Never commit the filled-in file. Procedures: docs/operations/runbook.md (section 1.2).

APP_ENV=staging
LOG_LEVEL=INFO

# PostgreSQL (the db service; DATABASE_URL is derived in the compose file)
POSTGRES_USER=pbip
POSTGRES_PASSWORD=<python3 -c "import secrets; print(secrets.token_urlsafe(18))">
POSTGRES_DB=pbip

# At least 32 characters; the API refuses to boot in staging/production with the dev value. Rotation: runbook 3.1
JWT_SECRET=<python3 -c "import secrets; print(secrets.token_urlsafe(48))">

# Comma-separated Fernet keys, first one encrypts, all decrypt. Rotation: runbook 3.2
FIELD_ENCRYPTION_KEY=<python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# Browser origins allowed to call the API; no wildcard
CORS_ORIGINS=https://<your-host>
COOKIE_SECURE=true

# Host port published by the web service (TLS is terminated in front of it; runbook 1.4)
PUBLIC_PORT=80

# Images are set per release by the deploy job; set them here only for a manual deploy or rollback (runbook 2.2)
IMAGE_PREFIX=ghcr.io/<owner>/pbip
IMAGE_TAG=v0.1.0

# Optional operational overrides (runbook 5.1 / 5.2)
# DAILY_TRANSFER_LIMIT_MINOR=50000000
# JWT_ACCESS_TTL_MINUTES=15
