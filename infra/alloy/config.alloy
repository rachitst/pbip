// Ships every container's stdout (our JSON logs) to Loki, labelled by compose service and container so
// Grafana can search them, e.g. {service="api"} | json | event="unhandled_exception" (TASK-103).
// Docker is the local socket, or DOCKER_HOST when set: on the staging host Alloy reaches Docker only through
// a read-only API proxy and never mounts the socket (ADR-0059).
discovery.docker "containers" {
  host = coalesce(sys.env("DOCKER_HOST"), "unix:///var/run/docker.sock")
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = coalesce(sys.env("DOCKER_HOST"), "unix:///var/run/docker.sock")
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
