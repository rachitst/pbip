# Copy to .env (cp .env.example .env). NEVER commit .env.
# Every value below is a LOCAL DEVELOPMENT value. Production secrets are generated
# per environment and stored in GitHub Environments / the server, never in git.

# local | test | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=pbip
POSTGRES_PASSWORD=pbip_local_password
POSTGRES_DB=pbip
# 127.0.0.1, not localhost: compose publishes db/redis on 127.0.0.1 only, and on Windows "localhost"
# tries ::1 first, which stalls every new connection (worker hang, /ready timeouts, k6 p95 > 50 ms).
DATABASE_URL=postgresql+psycopg://pbip:pbip_local_password@127.0.0.1:5432/pbip
TEST_DATABASE_URL=postgresql+psycopg://pbip:pbip_local_password@127.0.0.1:5432/pbip_test
# Seconds before opening a DB connection gives up (2-60); without it a stalled connect blocks forever.
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth / crypto (generate real ones: python -c "import secrets;print(secrets.token_urlsafe(48))") ---
JWT_SECRET=local-dev-only-change-me-local-dev-only-change-me
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
# Fernet key for field-level encryption (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=

# --- Web / cookies / CORS ---
CORS_ORIGINS=http://localhost:5173,https://localhost:8443
# must be true in staging/production
COOKIE_SECURE=false

# --- ML / assistant ---
MLFLOW_TRACKING_URI=http://localhost:5000
# Ollama on the host. `make dev-api` uses OLLAMA_BASE_URL; the compose api container uses
# OLLAMA_CONTAINER_URL (default http://host.docker.internal:11434). 3B fits an 8 GB laptop.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
# OLLAMA_CONTAINER_URL=http://host.docker.internal:11434
# Seconds to wait for the model before the keyword router answers; false = rules only.
OLLAMA_TIMEOUT_SECONDS=4
# How long Ollama keeps the model loaded after a question (Ollama duration: 30m, 24h, -1 = forever).
OLLAMA_KEEP_ALIVE=24h
ASSISTANT_LLM_ENABLED=true
# Optional: Groq's hosted API routes UNCLEAR assistant questions first, then Ollama, then the rules
# (ADR-0037). Only the redacted routing question leaves the stack. Keep ollama unless the owner
# approved Groq for this environment; staging/production refuse to boot with groq and no key/model.
LLM_PROVIDER=ollama
# Create at https://console.groq.com/keys; never commit it. Rotation: docs/operations/runbook.md.
GROQ_API_KEY=
# Chosen by the benchmark in ADR-0037 (scripts/benchmark_assistant_llm.py); unused while
# LLM_PROVIDER=ollama.
GROQ_MODEL=openai/gpt-oss-20b
# GPT-OSS: low | medium | high; empty = the model's default (medium). low kept full accuracy.
GROQ_REASONING_EFFORT=low

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=admin_local_password
# OpenTelemetry tracing (ADR 0017, ADR-0049). Off by default. OTEL_EXPORTER: none | console | otlp
# (memory is for tests and is refused in staging/production). otlp sends spans to the collector of
# the optional `otel` compose profile (docs/SETUP_GUIDE.md section 6); if it is down, spans are dropped.
OTEL_ENABLED=false
OTEL_EXPORTER=none
OTEL_SAMPLE_RATE=1.0
# make dev-api: the collector's published port. Compose containers use OTEL_COLLECTOR_CONTAINER_URL
# (default http://otel-collector:4318). OTEL_COLLECTOR_VERBOSITY: basic | detailed (every span).
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORT_TIMEOUT_SECONDS=2
OTEL_COLLECTOR_VERBOSITY=basic

# Optional: DB-IP country MMDB for the NEW_COUNTRY fraud rule (ADR-0014); fetch with
# uv run python scripts/fetch_geoip.py. Empty disables the rule.
GEOIP_COUNTRY_DB_PATH=
# Optional: DB-IP City Lite MMDB for the IMPOSSIBLE_TRAVEL fraud rule (ADR-0034); fetch with
# uv run python scripts/fetch_geoip.py --product city. Empty disables the rule. The thresholds
# below are the defaults (implied speed above, AND distance above, both must be exceeded).
GEOIP_CITY_DB_PATH=
FRAUD_TRAVEL_MAX_SPEED_KMH=900
FRAUD_TRAVEL_MIN_DISTANCE_KM=500
# Fraud scoring (ADR-0019): rules (default) or hybrid (rules floor + trained models). hybrid needs
# FRAUD_MODEL_DIR holding the artifacts of `python -m pbip_ml.fraud.train` (docs/ml/fraud-models.md);
# `make fraud-model` creates them. Missing or broken files -> rules only (logged), never ALLOW-all.
# Local and demo use hybrid (evaluation: docs/ml/model-evaluation-report-v1.md); the code default
# for any other deployment stays "rules".
FRAUD_SCORER=hybrid
FRAUD_MODEL_DIR=models/fraud
# Model step budget, 5-100 ms (contract p95 < 100 ms). Past it: rules only. Slow demo machine:
# measure with scripts/benchmark_fraud_latency.py first (docs/SETUP_GUIDE.md section 12).
FRAUD_MODEL_BUDGET_MS=50
# MULE_PASS_THROUGH rule (ADR-0035): inbound transfers from other customers within the window,
# totalling at least the minimum (minor units), with an outbound of at least the ratio (percent).
FRAUD_MULE_WINDOW_MINUTES=60
FRAUD_MULE_MIN_INBOUND_MINOR=1000000
FRAUD_MULE_MIN_RATIO_PERCENT=80
FRAUD_MULE_REPEAT_EPISODES=2
